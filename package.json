{
  "name": "chert-student-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "check": "node --check agent.mjs && node --check greet.mjs && node --check chert-rooms.mjs && node --check video.mjs && node --check outbound.mjs && node --check server.mjs && node --check solana.mjs && node --check imessage.mjs && node --check penalty.mjs && node --check wallet.mjs && node --check livesteps.mjs && node --check repchallenge.mjs",
    "help": "node agent.mjs --help",
    "call": "node --env-file=.env.local outbound.mjs",
    "server": "node --env-file=.env.local server.mjs",
    "wallet": "node --env-file=.env.local wallet.mjs",
    "pose": "pose/.venv/bin/python -u pose/pose_worker.py start",
    "pose:setup": "bash pose/setup.sh",
    "pose:test": "pose/.venv/bin/python -I pose/test_reps.py"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-google": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "@solana/web3.js": "1.99.0",
    "bs58": "4.0.1",
    "livekit-server-sdk": "2.19.3",
    "sharp": "0.35.3"
  }
}
