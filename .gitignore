# Dependencies
node_modules/

# Secrets: never commit
.env
.env.local
.env.*
!.env.example
secrets/

# Runtime state (step records, penalty signatures)
data/

# Logs and OS files
*.log
.DS_Store

# Xcode build output and per-user state
