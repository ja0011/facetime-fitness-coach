# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A model API key with Realtime access and available API credits.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-agent

# Outbound calls (outbound.mjs). Create the key in the Chert console: Developer -> Project API keys,
# scopes facetime:read and facetime:write. Project ID is shown there too. List line IDs with: npm run call -- --lines
CHERT_API_KEY=YOUR_CHERT_PROJECT_API_KEY
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_CHERT_LINE_ID
# Your own verified phone, international format, e.g. +15551234567
MY_PHONE=YOUR_VERIFIED_PHONE

# Step-count server (server.mjs). STEPS_TOKEN is a shared secret the Apple Shortcut sends; make one with:
#   openssl rand -hex 24
STEPS_TOKEN=YOUR_RANDOM_TOKEN
STEP_GOAL=8000
PORT=3000

# Solana DEVNET penalty (solana.mjs). The escrow secret key lives in secrets/escrow-keypair.json, never here.
# Create the escrow wallet: npm run wallet -- setup     Make a devnet charity address: npm run wallet -- new-charity
CHARITY_WALLET=YOUR_DEVNET_CHARITY_ADDRESS
PENALTY_SOL=0.05
# Optional; must be devnet (checked by genesis hash). Default: https://api.devnet.solana.com
# SOLANA_RPC_URL=

# Live walking challenge (livesteps.mjs). The agent reads StepStream's count from server.mjs on this Mac.
WALK_TARGET=300
WALK_CALLOUT_EVERY=25
WALK_CALLOUT_MIN_GAP_S=8
# LIVE_STEPS_URL=http://127.0.0.1:3000

# Extra tries when the shared line is busy with another team (one a minute after each 2-minute queue wait)
# BUSY_RETRIES=8

# Calls per day (server.mjs). A call can happen whenever steps are posted under goal, after a cooldown.
# "force": true in the /steps body skips the cooldown (demos). MAX_CALLS_PER_DAY is optional: unset or 0 = no limit.
CALL_COOLDOWN_MIN=30
# MAX_CALLS_PER_DAY=0

# Rep challenge after the walk (repchallenge.mjs + pose/pose_worker.py). Set REPS_TARGET=0 for walk only.
# The agent and the server both read REPS_TARGET; restart both after changing it.
REPS_TARGET=10
REPS_EXERCISE=squat
# REP_CALLOUT_MIN_GAP_S=1.2
# POSE_AGENT_NAME=          (default: <AGENT_NAME>-pose)

# Desk-break check-ins (server.mjs + challenge.mjs). The Shortcut posts today's step total several times a day;
# moving less than INACTIVE_STEPS since the previous report schedules a call at a random time in the delay window.
INACTIVE_STEPS=250
WORK_HOURS=9-17
RANDOM_DELAY_MIN=5
RANDOM_DELAY_MAX=30
# Jumping jacks as an optional random challenge (off by default)
# CHALLENGE_JACKS=1
# Demo mode: 5-20 s delay, work hours ignored, first report of the day counts as inactive, small challenges.
DEMO_MODE=0
# WALK_TARGET / REPS_TARGET / REPS_EXERCISE are now only fallbacks; each call picks its own random challenge.
